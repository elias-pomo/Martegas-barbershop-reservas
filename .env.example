# Base de datos
# Producción (Neon): DATABASE_URL = conexión "pooled" (host con -pooler); la usa la app.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require"
# Producción (Neon): conexión directa (sin -pooler), solo para migraciones y seed.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Tope de conexiones por instancia. Producción: 3 a 5. Local con `prisma dev`: 1.
DATABASE_POOL_MAX="3"

DEFAULT_BUSINESS_SLUG="martegas"
# Usuario inicial del panel (lo usa el seed)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="cambiar-esta-clave"

# Firma de la cookie de sesión del panel (32+ caracteres aleatorios)
SESSION_SECRET="generar-con-openssl-rand-base64-32"

# Notificaciones push (generar con: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:tu-email@ejemplo.com"
