// Modelo multi-negocio: todo cuelga de Business. Nada específico de un rubro.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  STAFF
}

enum AppointmentType {
  REGULAR
  SPECIAL
}

enum AppointmentStatus {
  CONFIRMED
  ATTENDED
  NO_SHOW
  LATE_CANCEL
  CANCELLED_BY_CUSTOMER
  CANCELLED_BY_BUSINESS
}

enum PaymentMethod {
  CASH
  TRANSFER
}

enum WaitlistStatus {
  WAITING
  CONTACTED
  CLOSED
}

enum CreatedBy {
  CUSTOMER
  ADMIN
}

model Business {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  timezone      String
  address       String?
  mapsUrl       String?
  whatsapp      String?
  instagram     String?
  paymentAlias  String?
  paymentHolder String?
  /// Colores y apariencia (JSON libre).
  theme         Json     @default("{}")
  /// Ver `businessSettingsSchema` en src/lib/domain/settings.ts
  settings      Json     @default("{}")
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  users        User[]
  staff        Staff[]
  services     Service[]
  customers    Customer[]
  appointments Appointment[]
  waitlist     WaitlistEntry[]
}

model User {
  id             String   @id @default(cuid())
  businessId     String
  email          String   @unique
  passwordHash   String
  role           Role     @default(OWNER)
  /// Se incrementa al cambiar credenciales: invalida las sesiones abiertas.
  sessionVersion Int      @default(0)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  business          Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  pushSubscriptions PushSubscription[]
}

model Staff {
  id         String  @id @default(cuid())
  businessId String
  name       String
  active     Boolean @default(true)

  business     Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  services     StaffService[]
  workingHours WorkingHours[]
  timeOff      TimeOff[]
  appointments Appointment[]

  @@index([businessId])
}

model Service {
  id          String  @id @default(cuid())
  businessId  String
  name        String
  /// Texto breve para clientes (qué incluye). Opcional.
  description String?
  durationMin Int
  price       Int
  active      Boolean @default(true)
  sortOrder   Int     @default(0)

  business     Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff        StaffService[]
  appointments Appointment[]

  @@index([businessId])
}

model StaffService {
  staffId   String
  serviceId String

  staff   Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
}

model WorkingHours {
  id         String @id @default(cuid())
  staffId    String
  /// 0 = domingo … 6 = sábado
  weekday    Int
  /// Primer inicio de turno, "HH:mm"
  firstStart String
  /// Último inicio de turno posible, "HH:mm"
  lastStart  String

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
}

model TimeOff {
  id       String   @id @default(cuid())
  staffId  String
  startsAt DateTime @db.Timestamptz(3)
  endsAt   DateTime @db.Timestamptz(3)
  reason   String?

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, startsAt])
}

model Customer {
  id         String   @id @default(cuid())
  businessId String
  name       String
  /// E.164, identifica al cliente dentro del negocio
  phone      String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@unique([businessId, phone])
}

/// La superposición de turnos activos la impide una restricción de exclusión
/// (ver migración `appointment_no_overlap`), no el código.
model Appointment {
  id             String            @id @default(cuid())
  businessId     String
  staffId        String
  serviceId      String?
  customerId     String
  type           AppointmentType   @default(REGULAR)
  status         AppointmentStatus @default(CONFIRMED)
  startsAt       DateTime          @db.Timestamptz(3)
  endsAt         DateTime          @db.Timestamptz(3)
  price          Int
  notes          String?
  address        String?
  people         Int               @default(1)
  cancelToken    String            @unique
  cancelCodeHash String
  createdBy      CreatedBy         @default(CUSTOMER)
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  cancelledAt    DateTime?         @db.Timestamptz(3)
  /// Cuándo el barbero mandó el recordatorio por WhatsApp.
  reminderSentAt DateTime?         @db.Timestamptz(3)
  /// Cómo se cobró (null = sin registrar).
  paymentMethod  PaymentMethod?
  paidAt         DateTime?         @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff    Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service  Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([businessId, startsAt])
  @@index([staffId, startsAt])
  @@index([customerId, startsAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Intentos de cancelación con teléfono + código (límite anti fuerza bruta).
model CancelAttempt {
  id         String   @id @default(cuid())
  businessId String
  phone      String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([businessId, phone, createdAt])
}

/// Clientes que quieren un turno en un día que está completo.
model WaitlistEntry {
  id         String         @id @default(cuid())
  businessId String
  /// Día local pedido, "YYYY-MM-DD".
  day        String
  serviceId  String?
  name       String
  /// E.164
  phone      String
  status     WaitlistStatus @default(WAITING)
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, day, phone])
  @@index([businessId, day, status])
}

/// Registro para límites de uso (login fallido, reservas y lista de espera por conexión).
model RateLimitHit {
  id        String   @id @default(cuid())
  /// "<acción>:<email|ip>", p. ej. "login-email:x@y.com" o "booking-ip:1.2.3.4"
  key       String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([key, createdAt])
}
